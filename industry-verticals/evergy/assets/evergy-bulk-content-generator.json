            "outputHtmlTemplateVarName": "htmlTemplate"
          },
          "showToUser": false,
          "displayName": "Extract Structure"
        },
        {
          "id": "compose_variant_message",
          "kind": "ComposeMessageForVariant",
          "config": {
            "loopVarName": "loop_content_generation_loop",
            "systemPrompt": "You are helping Evergy, an electric utility serving Kansas and Missouri. Generate content that matches the user request, the selected channel format, and the audience (residential vs. commercial & industrial): use plain, trustworthy language for homes and professional, operations-aware language for businesses. Follow the option metadata (dos, donts, tone). Do not fabricate specific rates, deadlines, or program rules—use general educational framing and point to evergy.com for official details when needed.",
            "outputVarName": "variantMessage",
            "messageTemplate": "Generate content for: {variantDescription}",
            "includeOptionDetails": true
          },
          "showToUser": false,
          "displayName": "Compose Message"
        },
        {
          "id": "generate_content",
          "kind": "GenerateContent",
          "config": {
            "model": "workflow-fast-model",
            "loopVarName": "loop_content_generation_loop",
            "temperature": 0.7,
            "artifactKind": "content_item",
            "inputVarName": "vars.variantMessage",
            "outputVarName": "generatedContent",
